.godot/
*.import

# scratch masters
art_source/
build/

# 2048 px originals of the room backgrounds (the game uses the 16:9 jpgs in assets/New/Map/Rooms/Backgrounds)
assets/New/Map/Rooms/_Source/*.png
# the big raw pictures of each Puppet act's stage (the game uses the pieces cut by tools/import_puppet_stage.py)
assets/Puppet/Stage/*/_Source/

# the 121 MB source PDF of the Puppet HUD (GitHub refuses files over 100 MB); it stays on the artist machine
assets/Puppet/_Source/Chant UI for puppet.pdf
# the raw 2048 px pictures ImageSet made for the Puppet UI (tools/import_puppet_ui.py cuts the small game pieces from them)
assets/Puppet/UI/_Source/*/*.png

# raw full-size ImageSet pictures (Name_YYYYMMDD_HHMMSS.png) that sit beside the cut-out files in the Puppet folders: kept on the artist machine for hand repair, only the cut files are committed
assets/Puppet/**/*_20[0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]*.png

# every generated variant of the spell card sounds (tools/make_spell_sfx.py keeps all 4 per spell here to choose again: 350 MB)
assets/Puppet/SFX/_Candidates/
assets/Puppet/_Source/Slot_machine.pdf

# the 107 MB source PDF of the HUD ver 2 (GitHub refuses files over 100 MB); it stays on the artist machine
assets/Puppet/UI/Hud2/Puppet HUD Nov.pdf

# ---- 2026-11 housekeeping (docs/plan_dot1_don_kho.md T1.1)
# Python bytecode of the tools
__pycache__/
*.pyc
# screenshot folders written by tools/*_shot.gd and by hand (never part of the game)
shots*/
scrshot/
screenshots/
# hand backups next to data files (the real file is the one without .bak)
*.bak.json
# scratch folders beside the cut art: backups, references, redo batches (the game never reads them)
assets/**/_Backup*/
assets/**/_Refs/
assets/**/_Redo/
assets/**/redo_refs/
# .m4a cannot be imported by Godot; keep such files outside the repo
*.m4a
*.m4a.txt
