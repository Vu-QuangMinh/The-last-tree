class_name BugHunterRig
extends RefCounted
## The Bug Hunter, Puppet Stage: the brass bell of Act2/bug hunter/bug hunter.pdf made of three pieces (assets/Puppet/Enemies/Act2/bug_hunter_rig/: bell = body, legs and
## the arm with the magnifying glass; eye; hand = the striker arm). BugHunterLayout (generated by tools/export_bug_hunter_rig.py) holds the PDF's four frames.
## - Idle: the eye slides between its Idle A and Idle B place, and the striker arm swings between Idle A and Idle B, each on its OWN beat (own speed, random pauses).
## - Strike (the PDF): the arm LOWERS SLOWLY to the lowered frame, then RAISES FAST to the raised frame (it lands on the bell there): that instant is the blow (sfx + rings
##   of sound + the bell shudders). The alarm is that, three times in a row, a little quicker. Then the arm goes back to its idle swing.
## - Rings: the sound-wave picture of the Winter Wyvern's roar (Act3/dragon/roar_wave.png), once to the left and once to the right of the bell.

const LOWER := 0.9  # seconds the arm takes to go down (slow)
const HOLD := 0.15  # it waits down there a moment
const RAISE := 0.13  # ... and comes up fast
const REST := 0.35  # after a blow: it stays up this long before the next one / going back
const BACK := 0.6  # from the raised frame back to the idle swing
const RING_TIME := 1.1
const SHAKE_TIME := 0.9
const SHAKE_ANG := 0.035  # the bell's shudder (radians, about its loop), decaying
const EYE_TIME := Vector2(0.9, 2.4)  # the eye's slide takes this long (random) ...
const EYE_PAUSE := Vector2(0.2, 1.6)  # ... then waits this long
const ARM_TIME := Vector2(1.3, 3.0)
const ARM_PAUSE := Vector2(0.1, 1.2)

var tex := {}
var wave: Texture2D
var _rng := RandomNumberGenerator.new()
var _eye := _Osc.new()
var _arm := _Osc.new()
var _plan: Array = []  # the strike: [[seconds, from angle, to angle, ease]] steps still to play
var _plan_t := 0.0
var _angle := 0.0  # the arm's angle now
var _clock := 0.0
var _shake_t := -1.0
var _ring_t := -1.0
var striking := false


class _Osc extends RefCounted:
	var u := 0.0
	var from := 0.0
	var to := 0.0
	var t := 0.0
	var dur := 1.0
	var wait := 0.0

	func step(d: float, rng: RandomNumberGenerator, times: Vector2, pauses: Vector2) -> void:
		if wait > 0.0:
			wait -= d
			return
		t += d
		var k := clampf(t / dur, 0.0, 1.0)
		u = lerpf(from, to, k * k * (3.0 - 2.0 * k))
		if k >= 1.0:
			from = to
			to = 1.0 - to if rng.randf() < 0.7 else rng.randf()  # (mostly the other end, sometimes somewhere between)
			t = 0.0
			dur = rng.randf_range(times.x, times.y)
			wait = rng.randf_range(pauses.x, pauses.y)


static func load_rig(act: int) -> BugHunterRig:
	var r := BugHunterRig.new()
	for n in ["bell", "eye", "hand"]:
		var p := Creature.enemy_path("bug_hunter_rig/%s.png" % n, act)
		if p == "":
			return null
		r.tex[n] = load(p)
	var wp := Creature.enemy_path("dragon/roar_wave.png", 3)
	r.wave = load(wp) if wp != "" else null
	r._rng.randomize()
	r._eye.u = r._rng.randf()
	r._arm.u = r._rng.randf()
	r._eye.to = 1.0 - r._eye.u
	r._arm.to = 1.0 - r._arm.u
	r._eye.from = r._eye.u
	r._arm.from = r._arm.u
	r._angle = r._idle_angle()
	return r


func height_px() -> float:
	return BugHunterLayout.BELL.y


func _idle_angle() -> float:
	return lerp_angle(BugHunterLayout.HAND_ANGLE.a, BugHunterLayout.HAND_ANGLE.b, _arm.u)


func tick(d: float, dead: bool) -> void:
	_clock += d
	if _shake_t >= 0.0:
		_shake_t += d
		if _shake_t > SHAKE_TIME:
			_shake_t = -1.0
	if _ring_t >= 0.0:
		_ring_t += d
		if _ring_t > RING_TIME + 0.5:
			_ring_t = -1.0
	if dead:
		_plan.clear()
		striking = false
	_eye.step(d, _rng, EYE_TIME, EYE_PAUSE)
	if _plan.is_empty():
		_arm.step(d, _rng, ARM_TIME, ARM_PAUSE)
		_angle = _idle_angle()
		return
	_plan_t += d
	while not _plan.is_empty() and _plan_t >= float(_plan[0][0]):
		_plan_t -= float(_plan[0][0])
		_angle = float(_plan[0][2])
		var ev: Variant = _plan[0][4]
		_plan.pop_front()
		if ev == "hit":
			_shake_t = 0.0
			_ring_t = 0.0
	if _plan.is_empty():
		striking = false
		_arm.u = 0.0  # (the idle swing goes on from where the arm came to rest: Idle A)
		_arm.from = 0.0
		_arm.to = 1.0
		_arm.t = 0.0
		_arm.wait = _rng.randf_range(0.2, 0.8)
		return
	var st: Array = _plan[0]
	var k := clampf(_plan_t / float(st[0]), 0.0, 1.0)
	k = k * k * (3.0 - 2.0 * k) if st[3] == "smooth" else k * k  # ("fast": it speeds up into the blow)
	_angle = lerp_angle(float(st[1]), float(st[2]), k)


## Play the strike (`blows` = 1, or 3 for the alarm). Returns the seconds until each blow lands, counted from now. The first blow is the hit of an attack.
func strike(blows: int) -> Array:
	var down: float = BugHunterLayout.HAND_ANGLE.down
	var up: float = BugHunterLayout.HAND_ANGLE.up
	var quick := blows > 1
	var lower := 0.26 if quick else LOWER  # (the alarm: blows 0.62 s apart, as in bell_alarm.wav)
	var hold := 0.05 if quick else HOLD
	var rest := 0.18 if quick else REST
	_plan.clear()
	_plan_t = 0.0
	var at := 0.0
	var hits := []
	var from := _angle
	for i in blows:
		_plan.append([lower, from, down, "smooth", ""])
		_plan.append([hold, down, down, "smooth", ""])
		_plan.append([RAISE, down, up, "fast", "hit"])
		at += lower + hold + RAISE
		hits.append(at)
		if i < blows - 1:
			_plan.append([rest, up, up, "smooth", ""])
			at += rest
		from = up
	_plan.append([REST, up, up, "smooth", ""])
	_plan.append([BACK, up, _idle_angle_target(), "smooth", ""])
	striking = true
	return hits


func _idle_angle_target() -> float:
	return BugHunterLayout.HAND_ANGLE.a


## Total seconds the strike takes (to the end of its way back).
func duration() -> float:
	var s := 0.0
	for st in _plan:
		s += float(st[0])
	return s - _plan_t


## ---- drawing ---------------------------------------------------------------------------------------------------------

## `base` puts the middle of its feet where they should stand, in `ci`'s coordinates; `scale` = screen px per layout px.
func draw(ci: CanvasItem, base: Transform2D, scale: float, mod: Color) -> void:
	var bell: Vector2 = BugHunterLayout.BELL
	var shake := 0.0
	if _shake_t >= 0.0:
		shake = sin(_shake_t * 62.0) * SHAKE_ANG * exp(-_shake_t * 4.5)
	# the whole thing shudders about the loop on top of the bell
	var loop := Vector2(bell.x * 0.5, 60.0)
	var root := base * Transform2D(0.0, Vector2(scale, scale), 0.0, Vector2.ZERO) * Transform2D(0.0, Vector2.ONE, 0.0, Vector2(-bell.x * 0.5, -bell.y))
	root = root * Transform2D(0.0, Vector2.ONE, 0.0, loop) * Transform2D(shake, Vector2.ONE, 0.0, Vector2.ZERO) * Transform2D(0.0, Vector2.ONE, 0.0, -loop)
	# the arm (behind the bell): turns about its shoulder, which stays put on the bell
	var sh: Vector2 = BugHunterLayout.SHOULDER
	var arm := Transform2D(_angle, Vector2.ONE, 0.0, BugHunterLayout.SHOULDER_AT) * Transform2D(0.0, Vector2.ONE, 0.0, -sh)
	ci.draw_set_transform_matrix(root * arm)
	ci.draw_texture_rect(tex.hand, Rect2(Vector2.ZERO, BugHunterLayout.HAND_SIZE), false, mod)
	ci.draw_set_transform_matrix(root)
	ci.draw_texture_rect(tex.bell, Rect2(Vector2.ZERO, bell), false, mod)
	var eye_at: Vector2 = (BugHunterLayout.EYE_A as Vector2).lerp(BugHunterLayout.EYE_B, _eye.u)
	ci.draw_texture_rect(tex.eye, Rect2(eye_at, BugHunterLayout.EYE_SIZE), false, mod)
	# the rings of sound, to both sides, one wave
	if _ring_t >= 0.0 and wave != null and mod.a > 0.5:
		var centre := Vector2(bell.x * 0.5, bell.y * 0.32)
		for i in 1:  # (ONE ring to each side)
			var ph := (_ring_t - i * 0.3) / RING_TIME
			if ph <= 0.0 or ph >= 1.0:
				continue
			var sz := wave.get_size() * lerpf(0.32, 0.62, ph)
			var off := bell.x * 0.5 + 60.0 + 520.0 * ph
			var col := Color(mod.r, mod.g, mod.b, (1.0 - ph) * 0.9)
			ci.draw_set_transform_matrix(root * Transform2D(0.0, Vector2.ONE, 0.0, centre + Vector2(-off, 0.0)))
			ci.draw_texture_rect(wave, Rect2(Vector2(-sz.x * 0.5, -sz.y * 0.5), sz), false, col)
			ci.draw_set_transform_matrix(root * Transform2D(0.0, Vector2(-1.0, 1.0), 0.0, centre + Vector2(off, 0.0)))
			ci.draw_texture_rect(wave, Rect2(Vector2(-sz.x * 0.5, -sz.y * 0.5), sz), false, col)
	ci.draw_set_transform_matrix(Transform2D.IDENTITY)
