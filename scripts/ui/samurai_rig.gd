class_name SamuraiRig
extends RefCounted
## The Samurai (Act 2 mini boss), Puppet Stage: the wooden samurai of Act2/samurai/animation.pdf, made of separate pieces (assets/Puppet/Enemies/Act2/samurai_rig/:
## body, back, two thighs, shins and feet, two upper arms and four forearm-with-sword pieces). SamuraiLayout (generated by tools/export_samurai_rig.py) holds every
## frame of the PDF: the leg and body pieces with their matrices, and for each ARM the angles of a chain: the upper arm turns about its shoulder (a point of the
## body), the forearm about the elbow (the upper arm's ball, in the forearm's socket). Between two frames the angles are blended, not the matrices, so an arm is
## always joined at the shoulder and the elbow, whatever way it swings.
## - Idle: the two arms sway (idle_a <-> idle_b).
## - His stance is the pose of the move he is about to make (intent `pose`): In no kamae (the slash), Ko gasumi (the Deflect: held until he changes), Sha no kamae
##   (the Iai charge = the PDF's "Hybrid 3x3"). He goes from idle to the READY frame of the stance and waits there. Changing stance plays the frames backwards to idle first.
## - strike(hit, hits): from the ready frame the swing plays on, and each blow lands at a HIT frame; after the last one he returns to idle.
## A forearm that is in one frame and not in the next (the swords swap hands) fades out / in across the middle of the way.

const SEQ := {
	"in_no_kamae": ["in_0", "in_1", "in_2", "in_3", "in_4", "in_5", "in_6", "in_7", "in_8"],
	"ko_gasumi": ["ko_0", "ko_1", "ko_2", "ko_3"],
	"sha_no_kamae": ["sha_0", "sha_1", "sha_2", "sha_3", "sha_4", "sha_5", "sha_6", "sha_7", "sha_8", "sha_9", "sha_10", "sha_11", "sha_12"],
}
## the frame he waits in while the stance is his intent
const READY := {"in_no_kamae": 4, "ko_gasumi": 3, "sha_no_kamae": 3}
## seconds each step takes (step i: frame i -> i + 1); the ones after READY are the swing
const STEP := {
	"in_no_kamae": [0.22, 0.22, 0.22, 0.22, 0.16, 0.1, 0.2, 0.2],
	"ko_gasumi": [0.28, 0.28, 0.28],
	"sha_no_kamae": [0.22, 0.2, 0.22, 0.14, 0.12, 0.1, 0.1, 0.14, 0.12, 0.1, 0.1, 0.16],
}
## the frame at which each blow lands: the PDF marks "Frame gay damage" (In no kamae) and "Hai chan ha xuong: tinh damage" twice (Hybrid 3x3). The first two blows of the
## Iai charge are the two swords coming down together (3 x 2), the third one is the long sword alone.
const HITS := {"in_no_kamae": [6], "sha_no_kamae": [7, 7, 11]}
const SWAY_TIME := 1.7  # seconds from one side to the other
const FADE := 0.3  # how much of a step (around its middle) a swapped forearm takes to fade

var tex := {}
var t := 0.0
var stance := ""
var seq := ""  # the sequence he is in ("": idle)
var pos := 0.0  # the frame he is at, in that sequence
var _goal := 0.0
var striking := false
var _height := 1.0  # the idle pose's height above its feet, in layout px (the creature scales it to its picture)
var _sway := 1.0  # 1: the idle sway; 0: the plain idle frame (while a stance starts)


static func load_rig(act: int) -> SamuraiRig:
	var r := SamuraiRig.new()
	for n in SamuraiLayout.SIZE:
		var p := Creature.enemy_path("samurai_rig/%s.png" % n, act)
		if p == "":
			return null
		r.tex[n] = load(p)
	var top := 0.0
	for pc in SamuraiLayout.FRAMES.idle.parts:
		var sz: Vector2 = SamuraiLayout.SIZE[pc[0]]
		for c in [Vector2.ZERO, Vector2(sz.x, 0.0)]:
			top = minf(top, ((pc[1] as Transform2D) * c).y)
	r._height = -top
	return r


func height_px() -> float:
	return _height


## `want` is the stance of his intent ("" for none); `dead` sends him back to idle.
func tick(d: float, want: String, dead: bool) -> void:
	t += d
	stance = "" if dead else want
	if striking:
		_move(d)
		if is_equal_approx(pos, _goal) and _goal >= float(SEQ[seq].size() - 1):
			seq = ""
			pos = 0.0
			striking = false
		return
	if seq != "" and seq != stance:
		_goal = 0.0  # (another stance, or none: back to idle by the same way)
		_move(d)
		if pos <= 0.0:
			seq = ""
	elif seq == "" and stance != "" and SEQ.has(stance):
		seq = stance
		pos = 0.0
	if seq != "" and seq == stance:
		_goal = float(READY[seq])
		_move(d)
	_sway = move_toward(_sway, 1.0 if seq == "" else 0.0, d * 3.0)


## Walk `pos` toward `_goal` through the steps, each at its own speed.
func _move(d: float) -> void:
	if seq == "":
		return
	var steps: Array = STEP[seq]
	var guard := 0
	while d > 0.0 and not is_equal_approx(pos, _goal) and guard < 40:
		guard += 1
		var dir := 1.0 if _goal > pos else -1.0
		var edge := floorf(pos + 1e-6) + 1.0 if dir > 0.0 else ceilf(pos - 1e-6) - 1.0
		var dist := minf(absf(edge - pos), absf(_goal - pos))
		var step_i := clampi(int(floorf(pos + 1e-6)) if dir > 0.0 else int(ceilf(pos - 1e-6)) - 1, 0, steps.size() - 1)
		var dur: float = steps[step_i]
		var need := dist * dur
		if need <= d:
			pos += dir * dist
			d -= need
		else:
			pos += dir * d / dur
			d = 0.0
	if is_equal_approx(pos, _goal):
		pos = _goal


## Seconds until the blow `hit` (0 based) lands, counted from now.
func strike(hit: int, hits: int) -> float:
	if not SEQ.has(stance) and seq == "":
		return 0.15
	if seq != stance and SEQ.has(stance):
		seq = stance  # (the intent changed in the same breath: no time to walk there)
		pos = float(READY[seq])
	if not HITS.has(seq):
		return 0.15
	var frames: Array = HITS[seq]
	var at: float = float(frames[mini(hit, frames.size() - 1)])
	striking = true
	_goal = float(SEQ[seq].size() - 1) if hit >= hits - 1 else at  # (after the last blow it plays on to idle)
	var from := pos
	var total := 0.0
	var steps: Array = STEP[seq]
	for i in range(int(floorf(from + 1e-6)), int(ceilf(at))):
		var l := minf(at, float(i + 1)) - maxf(from, float(i))
		if l > 0.0:
			total += steps[i] * l
	return maxf(0.08, total)


## ---- poses ------------------------------------------------------------------------------------------------------------
## A pose: {parts: [[piece, Transform2D, z]], l / r: {ang, sc (Vector2), z, fores: [{piece, ang, sc, z, a}]}}

static func _frame_pose(name: String) -> Dictionary:
	var fr: Dictionary = SamuraiLayout.FRAMES[name]
	var pose := {"parts": fr.parts}
	for side in ["l", "r"]:
		var a: Array = fr[side]
		pose[side] = {"ang": a[0], "sc": Vector2(a[1], a[2]), "z": a[7], "fores": [{"piece": a[3], "ang": a[4], "sc": Vector2(a[5], a[6]), "z": a[8], "a": 1.0}]}
	return pose


static func _blend(a: Dictionary, b: Dictionary, u: float) -> Dictionary:
	if u <= 0.0:
		return a
	if u >= 1.0:
		return b
	var near: Dictionary = a if u < 0.5 else b
	var parts := []
	for i in a.parts.size():
		var pa: Array = a.parts[i]
		var pb: Array = b.parts[i]
		parts.append([pa[0], (pa[1] as Transform2D).interpolate_with(pb[1], u), (near.parts[i] as Array)[2]])
	var out := {"parts": parts}
	var fade := clampf((u - (0.5 - FADE * 0.5)) / FADE, 0.0, 1.0)
	for side in ["l", "r"]:
		var arm_a: Dictionary = a[side]
		var arm_b: Dictionary = b[side]
		var fores := []
		var in_b := {}
		for fb in arm_b.fores:
			in_b[fb.piece] = fb
		var in_a := {}
		for fa in arm_a.fores:
			in_a[fa.piece] = fa
		for fa in arm_a.fores:
			if in_b.has(fa.piece):
				var fb: Dictionary = in_b[fa.piece]
				fores.append({"piece": fa.piece, "ang": lerp_angle(fa.ang, fb.ang, u), "sc": fa.sc.lerp(fb.sc, u), "z": fb.z if u >= 0.5 else fa.z, "a": lerpf(fa.a, fb.a, u)})
			else:
				var k: Dictionary = fa.duplicate()
				k.a = fa.a * (1.0 - fade)
				fores.append(k)
		for fb in arm_b.fores:
			if not in_a.has(fb.piece):
				var k: Dictionary = fb.duplicate()
				k.a = fb.a * fade
				fores.append(k)
		out[side] = {"ang": lerp_angle(arm_a.ang, arm_b.ang, u), "sc": arm_a.sc.lerp(arm_b.sc, u), "z": (near[side] as Dictionary).z, "fores": fores}
	return out


## The pose now.
func _pose() -> Dictionary:
	var sway_u := 0.5 + 0.5 * sin(t * PI / SWAY_TIME)
	var swaying := _blend(_frame_pose("idle"), _blend(_frame_pose("idle_a"), _frame_pose("idle_b"), sway_u), _sway)
	if seq == "":
		return swaying
	var names: Array = SEQ[seq]
	var i := clampi(int(floorf(pos + 1e-6)), 0, names.size() - 1)
	var a: Dictionary = swaying if i == 0 else _frame_pose(names[i])
	if i >= names.size() - 1:
		return a
	return _blend(a, _frame_pose(names[i + 1]), pos - float(i))


## ---- drawing --------------------------------------------------------------------------------------------------------

static func _rot_scale(ang: float, sc: Vector2) -> Transform2D:
	return Transform2D(Vector2(cos(ang), sin(ang)) * sc.x, Vector2(-sin(ang), cos(ang)) * sc.y, Vector2.ZERO)


## Draw him. `base` puts the middle of his feet where they should stand, in `ci`'s coordinates; `scale` = screen px per layout px.
func draw(ci: CanvasItem, base: Transform2D, scale: float, mod: Color) -> void:
	var root := base * Transform2D(0.0, Vector2(scale, scale), 0.0, Vector2.ZERO)
	var pose := _pose()
	var items := []  # [z, texture name, matrix, alpha]
	var body := Transform2D.IDENTITY
	for pc in pose.parts:
		if pc[0] == "body":
			body = pc[1]
		items.append([pc[2], pc[0], pc[1], 1.0])
	for side in ["l", "r"]:
		var arm: Dictionary = pose[side]
		var lin := _rot_scale(arm.ang, arm.sc)
		lin.origin = body * (SamuraiLayout.SHOULDER[side] as Vector2) - lin.basis_xform(SamuraiLayout.ROOT[side])
		items.append([arm.z, "arm_" + side, lin, 1.0])
		var elbow: Vector2 = lin * (SamuraiLayout.ELBOW[side] as Vector2)
		for f in arm.fores:
			var fl := Transform2D(lin.x, lin.y, Vector2.ZERO) * _rot_scale(f.ang, f.sc)
			fl.origin = elbow - fl.basis_xform(SamuraiLayout.SOCKET[f.piece])
			items.append([f.z, f.piece, fl, f.a])
	items.sort_custom(func(p, q): return p[0] < q[0])
	for it in items:
		if it[3] <= 0.01:
			continue
		ci.draw_set_transform_matrix(root * (it[2] as Transform2D))
		ci.draw_texture_rect(tex[it[1]], Rect2(Vector2.ZERO, SamuraiLayout.SIZE[it[1]]), false, Color(mod.r, mod.g, mod.b, mod.a * it[3]))
	ci.draw_set_transform_matrix(Transform2D.IDENTITY)
