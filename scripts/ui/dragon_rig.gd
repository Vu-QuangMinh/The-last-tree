class_name DragonRig
extends RefCounted
## The Winter Wyvern (Act 3 mini boss), Puppet Stage: the frost dragon of Dragon2/Dragon.pdf, made of separate pieces (assets/Puppet/Enemies/Act3/dragon_rig/: body,
## neck, throat, head, jaw, three tail segments, open wing, closed wing; and dragon/ for the effect pictures: fireball, burst, roar wave, slam dust).
## DragonLayout (generated by tools/export_dragon2_rig.py) says where each piece lies in the idle pose and where its joints are:
## body -> neck -> throat -> head -> jaw, body -> tail1 -> tail2 -> tail3. Creature draws it in place of the single picture and calls tick() every frame.
## The wyvern is TWO enemies (wyvern_head on the left, wyvern_tail on the right, the Fire Dragon's mechanics) that share ONE rig: each one's Creature
## draws its own pieces with draw_part() (the head: neck, throat, head, jaw; the tail: the last two tail segments; the body, the wing and the first
## tail segment belong to the head, or to the tail once the head has fallen). The two stand SPACING px apart; while the Fireball stands between them
## they are further apart, and the pieces are pulled together again so the dragon stays whole.
## What each part is doing is read from its enemy's intent `parts` ({head: bite | up, tail: sweep | slam}, see EnemyDefs), so the picture shows
## the move a turn before it happens (head up = fire / roar, tail raised = slam); Creature.dragon_fx() then plays the move. The wing is open, and folds
## over the head or the tail (the Fire Dragon's wing: EnemyState.winged), see _draw_wing_*.
## Angles are radians, clockwise positive (the screen's y points down), each relative to its parent. All coordinates are body-picture pixels.

const EFFECTS := ["fireball", "burst", "roar_wave", "slam_dust"]
const ATTACK_TIME := 0.9  # how long an attack plays
const CAST_TIME := 1.1  # fireball
const ROAR_TIME := 1.6  # roar: two slow waves, one after the other
const ROAR_WAVES := 2
const ROAR_WAVE_TIME := 0.9  # seconds one wave takes to travel (each starts 0.45 s after the one before)
const HIT_AT := {"bite": 0.4, "slam": 0.45, "sweep": 0.35, "blast": 0.25}  # seconds into the move when it lands
const FIRE_JAW := -0.56  # (the PDF's fire pose)
const TELE_UP := 0.08  # how much of the fire pose its head shows while the fire / roar is only an intent: next to nothing, it still looks down (the whole pose comes when it acts)
const IDLE_LOW := {"neck": -0.17, "throat": -0.14, "head": -0.16}  # at rest the head hangs lower and looks down (counter-clockwise leans a left-facing head forward)
const IDLE_JAW := 0.07  # the mouth is shut at rest
const TELE_BITE := {"neck": -0.04, "throat": -0.02, "head": -0.05, "jaw": -0.05}  # leaning at you, mouth a little open
const TELE_SLAM := [-0.16, -0.14, -0.12]  # the tail raised (each segment only a little over the one before: it must not fold up on itself)
const GUARD_TRACK := [[0.0, 0.0], [0.4, 1.0], [1.0, 1.0], [1.7, 0.0]]  # a wing folds down in 0.4 s, stays, and opens again slowly
const WING_SWEEP := {1: 1.5, -1: 0.63}  # how far (radians) the open wing swings down to lie closed over the front / the back
const WING_CLOSED_ROOT := Vector2(236.0, 55.0)  # where the closed wing's arm is, in its picture (the same joint as the open wing's root)
const SPACING := 580.0  # the distance between the head's and the tail's centres on the screen (EnemyView.WYVERN_VIEW_W + the 20 px between two views)
const ANCHOR := {"head": -150.0, "tail": 1580.0}  # the rig's x (body px) that stands at the middle of each part's view
const DROP := 50.0  # the dragon stands this much lower than where its parts' feet are
const WING_SPEED := 2.5  # the wing folds or opens in 1/2.5 s
## The tail's segments hang on a chain: each segment's far end is joined to the next one's metal eyelet by chain links (the segments swing apart when the tail whips,
## the links stretch to follow). Points are in each piece's own picture pixels. The farther along the tail, the lower a segment lies (tail3 under tail2 under tail1).
const TAIL_FAR := {"tail1": Vector2(320.0, 190.0), "tail2": Vector2(215.0, 115.0)}  # the middle of a segment's far end
const TAIL_EYE := {"tail2": Vector2(25.0, 60.0), "tail3": Vector2(40.0, 75.0)}  # the eyelet ring of a segment
const TAIL1_FREE_X := 80.0  # tail1's own picture from here on lies beyond the body (the first 80 px are tucked under the rump)
const LINK_LEN := 44.0  # a chain link, in body px
const LINK_W := 26.0
const LINK_THICK := 6.5
const LINK_COLOR := Color(0.72, 0.64, 0.5)
const LINK_DARK := Color(0.16, 0.12, 0.09)
const BALL_OFFSET := Vector2(-230.0, -300.0)  # the hovering Fireball, from the mouth of the fire pose

var tex := {}
var es := {}  # "head" / "tail" -> its EnemyState
var cr := {}  # "head" / "tail" -> its Creature
var _tick_frame := -1
var fx_tex := {}
var t := 0.0
var neck := 0.0
var throat := 0.0
var head := 0.0
var jaw := 0.0
var tail := [0.0, 0.0, 0.0]
var tail_s := 1.0
var tail_dy := 0.0
var wing := 0.0  # -1: the wing is folded over the tail, 0: open, 1: folded over the head (eased toward whichever part the wing covers)
var lunge := Vector2.ZERO
var fx := ""  # bite | slam | sweep | blast | fireball | roar
var fx_t := 0.0  # seconds left
var fx_dur := 1.0
var _ball := 0.0  # 0..1: how big the hovering Fireball is
var _burst_t := -1.0
var _pose := {}
var _mouth := Vector2.ZERO  # body px, last drawn
var _ball_at := Vector2.ZERO
var _dust_t := -1.0
var _dust_done := false
var last_root := Transform2D.IDENTITY  # body px -> the creature's own coordinates, as last drawn


static var _current: DragonRig


## The rig of the wyvern that `e` belongs to (the head creates it, the tail joins it) and registers its Creature.
static func for_part(e: EnemyState, c: Creature) -> DragonRig:
	var role: String = e.def.get("rig_part", "head")
	var r := _current
	if role == "head" or r == null or r.cr.has(role):
		r = load_rig(int(e.def.get("act", 3)))
		_current = r
	if r != null:
		r.es[role] = e
		r.cr[role] = c
	return r


static func load_rig(act: int) -> DragonRig:
	var r := DragonRig.new()
	for n in DragonLayout.SIZE:
		var p := Creature.enemy_path("dragon_rig/%s.png" % n, act)
		if p == "":
			return null
		r.tex[n] = load(p)
	for n in EFFECTS:
		var p := Creature.enemy_path("dragon/%s.png" % n, act)
		if p != "":
			r.fx_tex[n] = load(p)
	r._ball_at = r._fire_mouth() + BALL_OFFSET
	return r


## Where the mouth is in the PDF's fire pose (body px).
func _fire_mouth() -> Vector2:
	var a := {"neck": deg_to_rad(DragonLayout.FIRE_DEG.neck), "throat": deg_to_rad(DragonLayout.FIRE_DEG.throat), "head": deg_to_rad(DragonLayout.FIRE_DEG.head), "jaw": 0.0}
	return _mouth_of(_chain(a, Vector2.ZERO)["head"])


static func _rot(a: float, j: Vector2) -> Transform2D:
	var r := Transform2D(a, Vector2.ZERO)
	r.origin = j - r.basis_xform(j)
	return r


func _chain(a: Dictionary, lng: Vector2) -> Dictionary:
	var tn := _rot(a.neck, DragonLayout.JOINT.neck)
	tn.origin += lng
	var tt := tn * _rot(a.throat, DragonLayout.JOINT.throat)
	var th := tt * _rot(a.head, DragonLayout.JOINT.head)
	var tj := th * _rot(a.jaw, DragonLayout.JOINT.jaw)
	return {"neck": tn, "throat": tt, "head": th, "jaw": tj}


func _mouth_of(th: Transform2D) -> Vector2:
	return th * (DragonLayout.IDLE.head as Transform2D) * Vector2(14.0, 300.0)  # (the snout, low on the head picture)


## The hovering Fireball (FightScreen flies it into your HP bar): where it is (in the creature's own coordinates) and how wide it is drawn.
func ball_point() -> Vector2:
	return last_root * (_ball_at + Vector2(0.0, sin(t * 2.2) * 25.0))


func ball_width() -> float:
	return (fx_tex.fireball as Texture2D).get_width() * 0.45 * last_root.get_scale().x if fx_tex.has("fireball") else 0.0


func hide_ball() -> void:
	_ball = 0.0


## Start the move that is being acted out (called by FightScreen when the dragon acts): bite / slam / sweep / blast (attacks) or fireball / roar.
func play(e: EnemyState) -> void:
	_pose = e.intent.get("parts", {}) if e != null else {}
	var kind := String(e.intent.get("kind", "")) if e != null else ""
	if kind == "summon":
		fx = "fireball"
	elif kind == "empower":
		fx = "roar"
	elif _pose.get("tail", "") == "slam":
		fx = "slam"
	elif _pose.get("tail", "") == "sweep":
		fx = "sweep"
	else:
		fx = "bite"
	fx_dur = ROAR_TIME if fx == "roar" else (CAST_TIME if fx == "fireball" else ATTACK_TIME)
	fx_t = fx_dur
	_dust_t = -1.0
	_dust_done = false


## Seconds from the start of an attack until it lands (FightScreen waits that long before the damage).
func hit_time(e: EnemyState) -> float:
	var p: Dictionary = e.intent.get("parts", {})
	return HIT_AT.slam if p.get("tail", "") == "slam" else (HIT_AT.sweep if p.get("tail", "") == "sweep" else HIT_AT.bite)


## value at time `p` of a track [[time, value], ...] (smooth between keys, held before the first and after the last)
static func _track(p: float, keys: Array) -> float:
	if p <= keys[0][0]:
		return keys[0][1]
	for i in range(1, keys.size()):
		if p <= keys[i][0]:
			var a: Array = keys[i - 1]
			var b: Array = keys[i]
			return lerpf(a[1], b[1], smoothstep(0.0, 1.0, (p - a[0]) / maxf(0.0001, b[0] - a[0])))
	return keys[keys.size() - 1][1]


func tick(d: float) -> void:
	var frame := Engine.get_process_frames()
	if frame == _tick_frame:
		return  # (the head's and the tail's creatures both call it: once a frame)
	_tick_frame = frame
	var dead := true
	var pose := {}
	var want := 0.0
	for role in es:
		var pe: EnemyState = es[role]
		if pe.is_dead():
			continue
		dead = false
		pose.merge(pe.intent.get("parts", {}), true)
		if pe.winged:
			want = 1.0 if role == "head" else -1.0
	t += d
	fx_t = maxf(0.0, fx_t - d)
	if _burst_t >= 0.0:
		_burst_t += d
		if _burst_t > 0.6:
			_burst_t = -1.0
	if _dust_t >= 0.0:
		_dust_t += d
		if _dust_t > 0.7:
			_dust_t = -1.0
	var playing := fx_t > 0.0 and not dead
	var p := fx_dur - fx_t if playing else -1.0  # seconds into the move
	# idle: the neck, the head, the tail and the wing sway gently
	var n := sin(t * 1.1) * 0.025
	var th := sin(t * 1.3 + 1.0) * 0.03
	var hd := sin(t * 1.7 + 2.0) * 0.03
	var jw := IDLE_JAW
	var ta := [sin(t * 1.2) * 0.04, sin(t * 1.2 - 0.7) * 0.05, sin(t * 1.2 - 1.4) * 0.06]
	var ts := 1.0
	var tdy := 0.0
	var lg := Vector2.ZERO
	if pose.get("head", "") == "":
		n += IDLE_LOW.neck  # (an intent with a pose for the head raises it again: see below)
		th += IDLE_LOW.throat
		hd += IDLE_LOW.head
	match pose.get("head", ""):
		"bite":
			n += TELE_BITE.neck
			th += TELE_BITE.throat
			hd += TELE_BITE.head
			jw = TELE_BITE.jaw
		"up":  # the fire / roar: as an intent only a little more than the lowered head of rest, the mouth shut (the real pose comes with the move, below)
			n += IDLE_LOW.neck * 0.8 + deg_to_rad(DragonLayout.FIRE_DEG.neck) * TELE_UP
			th += IDLE_LOW.throat * 0.8 + deg_to_rad(DragonLayout.FIRE_DEG.throat) * TELE_UP
			hd += IDLE_LOW.head * 0.8 + deg_to_rad(DragonLayout.FIRE_DEG.head) * TELE_UP
	match pose.get("tail", ""):
		"sweep":  # it swings toward you: bigger and lower, lashing from side to side
			ts = 1.08
			tdy = 12.0
			ta = [sin(t * 3.0) * 0.1, sin(t * 3.0 - 0.8) * 0.12, sin(t * 3.0 - 1.6) * 0.14]
		"slam":
			ta = [TELE_SLAM[0] + sin(t * 2.0) * 0.04, TELE_SLAM[1] + sin(t * 2.0 - 0.6) * 0.04, TELE_SLAM[2] + sin(t * 2.0 - 1.2) * 0.04]
	if playing:
		match fx:
			"bite":
				var tl := TELE_BITE
				n = _track(p, [[0.0, tl.neck], [0.18, 0.14], [0.36, -0.38], [0.5, -0.38], [0.8, tl.neck]])
				th = _track(p, [[0.0, tl.throat], [0.18, 0.1], [0.36, -0.22], [0.5, -0.22], [0.8, tl.throat]])
				hd = _track(p, [[0.0, tl.head], [0.18, 0.16], [0.36, -0.32], [0.5, -0.32], [0.8, tl.head]])
				jw = _track(p, [[0.0, tl.jaw], [0.18, -0.2], [0.34, -0.6], [0.42, 0.06], [0.52, 0.06], [0.8, tl.jaw]])
				lg = Vector2(-1.0, 0.7) * 90.0 * _track(p, [[0.0, 0.0], [0.18, -0.3], [0.36, 1.0], [0.5, 1.0], [0.8, 0.0]])
			"fireball":
				var rise := _track(p, [[0.0, 0.0], [0.3, 1.0], [0.85, 1.0], [1.1, 0.0]])  # (the head comes up into the fire pose for the shot, then back down)
				n = lerpf(n, deg_to_rad(DragonLayout.FIRE_DEG.neck), rise)
				th = lerpf(th, deg_to_rad(DragonLayout.FIRE_DEG.throat), rise)
				hd = lerpf(hd, deg_to_rad(DragonLayout.FIRE_DEG.head), rise)
				jw = lerpf(jw, FIRE_JAW, rise)
				hd += 0.12 * _track(p, [[0.0, 0.0], [0.25, -1.0], [0.4, 0.4], [0.8, 0.0]])  # (it throws its head forward as the ball leaves)
			"roar":
				var up := _track(p, [[0.0, 0.0], [0.25, 1.0], [1.3, 1.0], [1.6, 0.0]])
				n = lerpf(n, deg_to_rad(DragonLayout.FIRE_DEG.neck) + 0.1, up)
				th = lerpf(th, deg_to_rad(DragonLayout.FIRE_DEG.throat), up)
				hd = lerpf(hd, deg_to_rad(DragonLayout.FIRE_DEG.head) + 0.12, up)
				jw = lerpf(jw, FIRE_JAW * (0.85 + 0.15 * sin(p * 9.0)), up)
				lg = Vector2(sin(p * 24.0) * 3.0, 0.0)  # (its whole neck trembles)
			"slam":
				var raise := _track(p, [[0.0, 0.0], [0.3, 1.0], [0.45, 1.0], [0.9, 0.3]])  # (it rears the tail up a little more first)
				var strike := _track(p, [[0.0, 0.0], [0.3, 0.0], [0.45, 1.0], [0.65, 1.0], [0.9, 0.0]])
				for i in 3:
					ta[i] = lerpf(TELE_SLAM[i] - 0.1 * raise, 0.12 - 0.02 * i, strike)
				if p >= 0.45 and not _dust_done:
					_dust_done = true
					_dust_t = 0.0
			"sweep":
				var s := _track(p, [[0.0, 0.0], [0.35, 1.0], [0.9, 0.0]])
				ts = 1.08 + 0.2 * s
				tdy = 12.0 + 24.0 * s
				ta = [sin(p * 9.0) * 0.16, sin(p * 9.0 - 0.8) * 0.19, sin(p * 9.0 - 1.6) * 0.22]
	var k := minf(1.0, d * (14.0 if playing else 6.0))
	neck = lerpf(neck, n, k)
	throat = lerpf(throat, th, k)
	head = lerpf(head, hd, k)
	jaw = lerpf(jaw, jw, minf(1.0, d * (25.0 if playing else 6.0)))
	for i in 3:
		tail[i] = lerpf(tail[i], ta[i], minf(1.0, d * (16.0 if playing and fx == "slam" else 6.0)))
	tail_s = lerpf(tail_s, ts, k)
	tail_dy = lerpf(tail_dy, tdy, k)
	lunge = lunge.lerp(lg, minf(1.0, d * 18.0))
	wing = move_toward(wing, want, d * WING_SPEED)


## Draw the pieces that belong to one part of the wyvern ("head" or "tail"). `base` puts the point under that part's feet (the middle of its view, the ground)
## where it should be, in `ci`'s coordinates.
func draw_part(ci: Control, base: Transform2D, mod: Color, role: String) -> void:
	var kk := SPACING / (float(ANCHOR.tail) - float(ANCHOR.head))
	var root := base * Transform2D(0.0, Vector2(kk, kk), 0.0, Vector2(-float(ANCHOR[role]) * kk, -float(DragonLayout.GROUND) * kk))  # (body px -> screen)
	# the whole dragon (its box, wing and tail included) stands in the middle of the screen, DROP px lower than where its feet were put; each part works the
	# same shift out for itself from its own place (after the pull that keeps the two halves together while the Fireball stands between them), so they still meet.
	root.origin.x += _pull(ci, role)
	var gt := ci.get_global_transform()
	var mid: Vector2 = gt * (root * Vector2(DragonLayout.EXTENT.get_center().x, float(DragonLayout.GROUND)))
	root.origin += Vector2((ci.get_viewport_rect().size.x * 0.5 - mid.x) / maxf(0.01, gt.get_scale().x), DROP)
	if role == "head" or not cr.has("head") or not _alive("head"):
		last_root = root
	var c := _chain({"neck": neck, "throat": throat, "head": head, "jaw": jaw}, lunge)
	# the tail: scaled about its root (it comes toward you), then each segment on the one before
	var jr: Vector2 = DragonLayout.JOINT.tail1
	var tail_t := Transform2D(0.0, Vector2(tail_s, tail_s), 0.0, Vector2.ZERO)
	tail_t.origin = jr - tail_t.basis_xform(jr) + Vector2(0.0, tail_dy)
	var t1 := tail_t * _rot(tail[0], DragonLayout.JOINT.tail1)
	var t2 := t1 * _rot(tail[1], DragonLayout.JOINT.tail2)
	var t3 := t2 * _rot(tail[2], DragonLayout.JOINT.tail3)
	var xf := {"body": Transform2D.IDENTITY, "neck": c.neck, "throat": c.throat, "head": c.head, "jaw": c.jaw,
		"tail1": t1, "tail2": t2, "tail3": t3}
	var owns_body: bool = (role == "head") == _alive("head")  # (the head holds the body; once it has fallen, the tail does)
	var in_front := tail_s > 1.2  # (a tail that comes at you is drawn over the body)
	if not in_front:
		_draw_tail(ci, root, xf, role, mod, owns_body)  # (behind the body)
	_mouth = _mouth_of(c.head)
	var e := smoothstep(0.0, 1.0, absf(wing))  # (how far folded: 0 open .. 1 closed)
	var open_a := 1.0 - smoothstep(0.45, 0.9, e)
	for k in DragonLayout.PAINT:
		var mine: bool
		match k:
			"tail2", "tail3":
				mine = role == "tail"
			"neck", "throat", "jaw", "head":
				mine = role == "head"
			_:  # tail1, body, wing_open
				mine = owns_body
		if not mine or (k == "wing_open" and open_a <= 0.01) or k.begins_with("tail"):
			continue  # (the tail is drawn together, see _draw_tail)
		if k == "wing_open":
			_draw_wing_open(ci, root, e, mod, open_a)
		else:
			_piece(ci, root, xf[k], k, mod, 1.0)
	if in_front:
		_draw_tail(ci, root, xf, role, mod, owns_body)
	if owns_body and e > 0.02:
		_draw_wing_closed(ci, root, e, mod)
	if role == "head":
		_draw_fx(ci, root, mod, "head")
	else:
		_draw_fx(ci, root, mod, "tail")
	ci.draw_set_transform_matrix(Transform2D.IDENTITY)


## The tail: the last segment underneath, then the one before it, then the first (the farther along the tail, the lower it lies), a chain between each two.
## The tail's creature draws segments 2 and 3 and the chains; the first segment belongs to the creature that holds the body (it lies under the rump there), and the
## tail's creature puts the part of it that lies beyond the body on top of segment 2 again, so that it covers the segment after it.
func _draw_tail(ci: Control, root: Transform2D, xf: Dictionary, role: String, mod: Color, owns_body: bool) -> void:
	if role == "tail":
		_piece(ci, root, xf.tail3, "tail3", mod, 1.0)
		_draw_chain(ci, root, xf, "tail2", "tail3", mod)
		_piece(ci, root, xf.tail2, "tail2", mod, 1.0)
		_draw_chain(ci, root, xf, "tail1", "tail2", mod)
		if owns_body:
			_piece(ci, root, xf.tail1, "tail1", mod, 1.0)
		else:
			var size: Vector2 = DragonLayout.SIZE.tail1
			_piece_region(ci, root * xf.tail1 * (DragonLayout.IDLE.tail1 as Transform2D), "tail1", mod, Rect2(TAIL1_FREE_X, 0.0, size.x - TAIL1_FREE_X, size.y))
	elif owns_body:
		_piece(ci, root, xf.tail1, "tail1", mod, 1.0)


## A chain from the far end of one tail segment to the eyelet of the next: links alternate flat and edge-on, and there are as many as the gap needs.
func _draw_chain(ci: CanvasItem, root: Transform2D, xf: Dictionary, from_piece: String, to_piece: String, mod: Color) -> void:
	var a: Vector2 = root * (xf[from_piece] as Transform2D) * (DragonLayout.IDLE[from_piece] as Transform2D) * (TAIL_FAR[from_piece] as Vector2)
	var b: Vector2 = root * (xf[to_piece] as Transform2D) * (DragonLayout.IDLE[to_piece] as Transform2D) * (TAIL_EYE[to_piece] as Vector2)
	var k: float = root.get_scale().x
	var d := b - a
	var dist := d.length()
	if dist < 1.0:
		return
	var ang := d.angle()
	var n := maxi(2, int(ceil(dist / (LINK_LEN * k * 0.7))))
	ci.draw_set_transform_matrix(Transform2D.IDENTITY)
	for i in n:
		var c := a + d * ((i + 0.5) / float(n))
		var flat := i % 2 == 0
		var hl := LINK_LEN * k * 0.5
		var hw := LINK_W * k * 0.5 if flat else LINK_THICK * k * 0.8
		var pts := PackedVector2Array()
		for j in 17:
			var q := Vector2(cos(j / 16.0 * TAU) * hl, sin(j / 16.0 * TAU) * hw).rotated(ang)
			pts.append(c + q)
		ci.draw_polyline(pts, Color(LINK_DARK.r * mod.r, LINK_DARK.g * mod.g, LINK_DARK.b * mod.b, mod.a), LINK_THICK * k * 1.9, true)
		ci.draw_polyline(pts, Color(LINK_COLOR.r * mod.r, LINK_COLOR.g * mod.g, LINK_COLOR.b * mod.b, mod.a), LINK_THICK * k, true)


func _alive(role: String) -> bool:
	return es.has(role) and not (es[role] as EnemyState).is_dead()


## How far (in `ci`'s coordinates) to pull this part toward the other one: while the Fireball stands between the two they are further apart than
## SPACING, and the dragon is kept whole by drawing each part half of that surplus nearer to the other.
func _pull(ci: Control, role: String) -> float:
	var other = cr.get("tail" if role == "head" else "head")
	if other == null or not is_instance_valid(other) or not _alive("head") or not _alive("tail"):
		return 0.0
	var sc: float = ci.get_global_transform().get_scale().x
	var mid_a: Vector2 = ci.get_global_transform() * Vector2(ci.size.x * 0.5, 0.0)
	var mid_b: Vector2 = other.get_global_transform() * Vector2(other.size.x * 0.5, 0.0)
	var gap: float = absf(mid_b.x - mid_a.x) - SPACING * sc
	if gap <= 1.0:
		return 0.0
	return (gap * 0.5 / maxf(0.01, sc)) * (1.0 if role == "head" else -1.0)


## Scale about a point.
static func _scale_about(k: float, j: Vector2) -> Transform2D:
	var m := Transform2D(0.0, Vector2(k, k), 0.0, Vector2.ZERO)
	m.origin = j - m.basis_xform(j)
	return m


## The open wing, breathing a little. Folding (e 0 -> 1): its arm swings down about its root toward where the closed wing lies, shrinking, and fades out
## while the closed wing grows out of the same root (_draw_wing_closed), so the one wing seems to fold into the other.
func _draw_wing_open(ci: CanvasItem, root: Transform2D, e: float, mod: Color, alpha: float) -> void:
	var j: Vector2 = DragonLayout.JOINT.wing_open
	var sweep: float = WING_SWEEP[1 if wing > 0.0 else -1]
	var flap := (sin(t * 1.4) * 0.04 + sin(t * 0.7 + 1.0) * 0.02) * (1.0 - e)  # (the open wing lifts and settles all the time)
	var m := _rot(flap + sweep * e, j) * _scale_about(1.0 - 0.45 * e + 0.015 * sin(t * 1.5 + 0.6) * (1.0 - e), j)
	_piece(ci, root, m, "wing_open", mod, alpha)


## The closed wing: it opens out of the wing's root, turning down as it grows, and settles over the front (or the back) of the body.
func _draw_wing_closed(ci: CanvasItem, root: Transform2D, e: float, mod: Color) -> void:
	var j: Vector2 = DragonLayout.JOINT.wing_open
	var side := 1 if wing > 0.0 else -1
	var place: Transform2D = DragonLayout.WING_FRONT if side > 0 else DragonLayout.WING_BACK
	var m := _rot(-float(WING_SWEEP[side]) * (1.0 - e) + sin(t * 1.4 + 0.5) * 0.025 * e, j) * _scale_about(0.3 + 0.7 * e, j) * place  # (a closed wing sways a little too)
	_piece_m(ci, root * m, "wing_closed", mod, smoothstep(0.08, 0.5, e))


func _piece(ci: CanvasItem, root: Transform2D, tf: Transform2D, piece: String, mod: Color, alpha: float) -> void:
	_piece_m(ci, root * tf * (DragonLayout.IDLE[piece] as Transform2D), piece, mod, alpha)


func _piece_region(ci: CanvasItem, m: Transform2D, piece: String, mod: Color, src: Rect2) -> void:
	ci.draw_set_transform_matrix(m)
	ci.draw_texture_rect_region(tex[piece], src, src, mod)


func _piece_m(ci: CanvasItem, m: Transform2D, piece: String, mod: Color, alpha: float) -> void:
	ci.draw_set_transform_matrix(m)
	ci.draw_texture_rect(tex[piece], Rect2(Vector2.ZERO, DragonLayout.SIZE[piece]), false, Color(mod.r, mod.g, mod.b, mod.a * alpha))


func _draw_ball(ci: CanvasItem, root: Transform2D, mod: Color) -> void:
	if _ball <= 0.0 or not fx_tex.has("fireball"):
		return
	var ft: Texture2D = fx_tex.fireball
	var pulse := 1.0 + 0.06 * sin(t * 9.0)
	var at := _ball_at + Vector2(0.0, sin(t * 2.2) * 25.0)
	var sz := ft.get_size() * 0.45 * _ball * pulse
	ci.draw_set_transform_matrix(root * Transform2D(sin(t * 3.0) * 0.08, Vector2.ONE, 0.0, at))
	ci.draw_texture_rect(ft, Rect2(-sz * 0.5, sz), false, mod)


func _draw_fx(ci: CanvasItem, root: Transform2D, mod: Color, role: String) -> void:
	if role == "head" and _burst_t >= 0.0 and fx_tex.has("burst"):
		var bt: Texture2D = fx_tex.burst
		var q := _burst_t / 0.6
		var sz := bt.get_size() * lerpf(0.2, 0.7, q)
		ci.draw_set_transform_matrix(root * Transform2D(0.0, Vector2.ONE, 0.0, _ball_at))
		ci.draw_texture_rect(bt, Rect2(-sz * 0.5, sz), false, Color(mod.r, mod.g, mod.b, 1.0 - q))
	if role == "tail" and _dust_t >= 0.0 and fx_tex.has("slam_dust"):
		var dt: Texture2D = fx_tex.slam_dust
		var q := _dust_t / 0.7
		var sz := dt.get_size() * lerpf(0.25, 0.75, q)
		ci.draw_set_transform_matrix(root * Transform2D(0.0, Vector2.ONE, 0.0, Vector2(1750.0, float(DragonLayout.GROUND))))
		ci.draw_texture_rect(dt, Rect2(Vector2(-sz.x * 0.5, -sz.y), sz), false, Color(mod.r, mod.g, mod.b, 1.0 - q))
	if role == "head" and fx_t > 0.0 and fx == "roar" and fx_tex.has("roar_wave"):
		var rt: Texture2D = fx_tex.roar_wave
		var secs := fx_dur - fx_t
		for i in ROAR_WAVES:
			var ph := (secs - 0.15 - i * 0.45) / ROAR_WAVE_TIME  # (each wave goes out once: 0 at the mouth .. 1 gone)
			if ph <= 0.0 or ph >= 1.0:
				continue
			var sz := rt.get_size() * lerpf(0.2, 0.5, ph)
			ci.draw_set_transform_matrix(root * Transform2D(head * 0.5, Vector2.ONE, 0.0, _mouth + Vector2(-60.0 - 380.0 * ph, -40.0 - 120.0 * ph)))
			ci.draw_texture_rect(rt, Rect2(Vector2(-sz.x, -sz.y * 0.5), sz), false, Color(mod.r, mod.g, mod.b, (1.0 - ph) * 0.9))
