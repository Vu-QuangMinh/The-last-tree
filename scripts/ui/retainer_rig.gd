class_name RetainerRig
extends RefCounted
## The Samurai's Retainer (Act 2), Puppet Stage: his body stands still and his FRONT ARM turns about the shoulder (RetainerLayout, generated by
## tools/export_samurai_rig.py from Act2/samurai/animation.pdf), carrying the bottle (and the thumb) or the fan in its hand. The arm is turned about the shoulder
## (never slid), so it stays joined to the body whatever the angle.
## - mode "bottle": the arm between the pictures "bottle" (idle, the bottle held out) and "lower" (the hand lowered before the throw): `lower` 0..1.
## - mode "fan": the arm between "fan1" (the fan raised) and "fan2" (lowered): `wave` 0..1; play_fan() waves it up and down, slowly and smoothly.
## - play_throw(): the hand goes down a little, then comes up fast to the idle place; the moment it starts to come up is `release_time()`: the bottle leaves the hand
##   there (FightScreen flies it), and comes back to the hand a little after.
## The gong poses and the kneeling pose are finished pictures (Creature draws them).

const LOWER_TIME := 0.32
const HOLD_TIME := 0.1
const RAISE_TIME := 0.12
const BACK_TIME := 0.8  # after the throw, seconds until the next bottle is in his hand
const WAVE_PERIOD := 1.3  # seconds for the fan to go down and up once
const WAVE_CYCLES := 2

var tex := {}
var t := 0.0
var mode := "bottle"
var lower := 0.0
var wave := 0.0
var bottle_a := 1.0  # the bottle in his hand: 1 there, 0 thrown
var _throw := -1.0  # seconds into the throw (-1: none)
var _wave_t := -1.0  # seconds into the waving (-1: none)
var bottle_center := Vector2.ZERO  # where the bottle was drawn, in the creature's own coordinates (for the throw)
var bottle_px := 0.0  # and how wide, in the same coordinates


static func load_rig(act: int) -> RetainerRig:
	var r := RetainerRig.new()
	for n in RetainerLayout.SIZE:
		var p := Creature.enemy_path("samurai_retainer_rig/%s.png" % n, act)
		if p == "":
			return null
		r.tex[n] = load(p)
	return r


## Seconds from the start of the throw until the bottle leaves the hand.
static func release_time() -> float:
	return LOWER_TIME + HOLD_TIME


static func throw_time() -> float:
	return LOWER_TIME + HOLD_TIME + RAISE_TIME


func play_throw() -> void:
	_throw = 0.0
	_wave_t = -1.0


func play_fan() -> float:
	_wave_t = 0.0
	_throw = -1.0
	return WAVE_PERIOD * WAVE_CYCLES


func tick(d: float, want_mode: String) -> void:
	t += d
	mode = want_mode
	if _throw >= 0.0:
		_throw += d
		if _throw < LOWER_TIME:
			lower = smoothstep(0.0, 1.0, _throw / LOWER_TIME)
		elif _throw < LOWER_TIME + HOLD_TIME:
			lower = 1.0
		elif _throw < throw_time():
			lower = 1.0 - smoothstep(0.0, 1.0, (_throw - LOWER_TIME - HOLD_TIME) / RAISE_TIME)
		else:
			lower = 0.0
		bottle_a = 1.0 if _throw < release_time() else (0.0 if _throw < throw_time() + BACK_TIME else clampf((_throw - throw_time() - BACK_TIME) / 0.3, 0.0, 1.0))
		if _throw > throw_time() + BACK_TIME + 0.3:
			_throw = -1.0
			bottle_a = 1.0
	else:
		lower = move_toward(lower, 0.0, d * 3.0)
		bottle_a = move_toward(bottle_a, 1.0, d * 3.0)
	if _wave_t >= 0.0:
		_wave_t += d
		var total := WAVE_PERIOD * WAVE_CYCLES
		wave = 0.5 - 0.5 * cos(minf(_wave_t, total) / WAVE_PERIOD * TAU)  # (0 .. 1 .. 0, smooth, ending where it began)
		if _wave_t >= total:
			_wave_t = -1.0
			wave = 0.0
	else:
		wave = move_toward(wave, 0.0, d * 2.0)


static func _rot_scale(ang: float, sc: Vector2) -> Transform2D:
	return Transform2D(Vector2(cos(ang), sin(ang)) * sc.x, Vector2(-sin(ang), cos(ang)) * sc.y, Vector2.ZERO)


## Draw him. `base` puts the middle of his body's feet where they should stand, in `ci`'s coordinates; `scale` = screen px per layout px.
func draw(ci: CanvasItem, base: Transform2D, scale: float, mod: Color) -> void:
	var root := base * Transform2D(0.0, Vector2(scale, scale), 0.0, Vector2.ZERO)
	var pa := "fan1" if mode == "fan" else "bottle"
	var pb := "fan2" if mode == "fan" else "lower"
	var w := wave if mode == "fan" else lower
	var a: Dictionary = RetainerLayout.POSES[pa]
	var b: Dictionary = RetainerLayout.POSES[pb]
	var items := []  # [z, piece, matrix, alpha]
	var body := Transform2D.IDENTITY
	for pc in a.static:
		items.append([pc[2], pc[0], pc[1], 1.0])
		if pc[0] == "body":
			body = pc[1]
	var aa: Array = a.arm
	var ab: Array = b.arm
	var lin := _rot_scale(lerp_angle(aa[0], ab[0], w), Vector2(aa[1], aa[2]).lerp(Vector2(ab[1], ab[2]), w))
	lin.origin = body * (RetainerLayout.SHOULDER as Vector2) - lin.basis_xform(RetainerLayout.ROOT)
	items.append([aa[3], "arm_front", lin, 1.0])
	for kid in a.kids:
		if not b.kids.has(kid):
			continue
		var ka: Array = a.kids[kid]
		var kb: Array = b.kids[kid]
		var hand: Array = RetainerLayout.HAND[kid]
		var kl := Transform2D(lin.x, lin.y, Vector2.ZERO) * _rot_scale(lerp_angle(ka[0], kb[0], w), Vector2(ka[1], ka[2]).lerp(Vector2(kb[1], kb[2]), w))
		kl.origin = lin * (hand[0] as Vector2) - kl.basis_xform(hand[1])
		var alpha := 1.0
		if kid == "bottle":
			alpha = bottle_a
			bottle_center = root * (kl * (Vector2(RetainerLayout.SIZE.bottle) * 0.5))
			bottle_px = float(RetainerLayout.SIZE.bottle.x) * kl.x.length() * scale
		items.append([ka[3], kid, kl, alpha])
	items.sort_custom(func(p, q): return p[0] < q[0])
	for it in items:
		if it[3] <= 0.01:
			continue
		ci.draw_set_transform_matrix(root * (it[2] as Transform2D))
		ci.draw_texture_rect(tex[it[1]], Rect2(Vector2.ZERO, RetainerLayout.SIZE[it[1]]), false, Color(mod.r, mod.g, mod.b, mod.a * it[3]))
	ci.draw_set_transform_matrix(Transform2D.IDENTITY)
